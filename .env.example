# En local, copia este archivo como .env. En Render, crea las mismas variables.
SECRET_KEY=cambia-esta-clave
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-correo@gmail.com
# Usa una contraseña de aplicación nueva de Google, no tu contraseña normal.
EMAIL_HOST_PASSWORD=pega-aqui-la-contraseña-de-aplicacion
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CAP Online <tu-correo@gmail.com>

# Origen interno de la app Capacitor. No agregues dominios web desconocidos.
MOBILE_ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost
SECURE_HSTS_SECONDS=3600

# Recomendado para videollamadas entre redes diferentes (servicio TURN).
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Imágenes persistentes de perfiles médicos (Cloudinary Console > API Keys).
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
